# Copie este arquivo para ".env" e preencha com os seus valores.
# NUNCA versione nem envie o ".env" real (ele já está no .gitignore).

# Porta da aplicação
PORT=8080

# Oracle (o docker-compose repassa para SPRING_DATASOURCE_*)
ORACLE_URL=jdbc:oracle:thin:@//host-do-oracle:1521/servico
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha

# Redis: usado ao rodar fora do Docker. No docker-compose o host é sempre "redis".
REDIS_HOST=localhost
REDIS_PORT=6379